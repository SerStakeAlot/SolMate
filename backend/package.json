{
  "name": "solmate-backend",
  "version": "1.0.0",
  "description": "Backend server for SolMate chess game with real-time multiplayer",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts"
